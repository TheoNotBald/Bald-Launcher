<Window x:Class="BaldLauncher.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BaldLauncher.Native"
        mc:Ignorable="d"
        Title="Bald Launcher" Height="820" Width="1320"
        MinHeight="620" MinWidth="980"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource WindowBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,0">
                <Border Width="28" Height="28" CornerRadius="7" Background="#2D6E1A" DockPanel.Dock="Left">
                    <TextBlock Text="B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Bald Launcher" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceRaised}" CornerRadius="14" Padding="10,4">
                    <TextBlock Text="TheNotBald  ›" Foreground="{StaticResource SecondaryText}"/>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource SurfaceBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="10,12">
                    <Button Content="⌂" ToolTip="Home" Click="Home_Click"/>
                    <Button Content="▤" ToolTip="Resource packs" Click="Browse_Click"/>
                    <Button Content="♙" ToolTip="Accounts"/>
                    <Button Content="⚙" ToolTip="Settings"/>
                    <Separator Margin="0,12"/>
                    <Button Content="♧" ToolTip="Servers"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" x:Name="ContentRoot">
                <Grid x:Name="BrowseView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128"/>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,20,24,12">
                        <TextBlock Text="RESOURCE PACK CREATOR / BROWSER" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Browse Minecraft Textures" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,3"/>
                        <TextBlock Text="Block textures, item icons, mob skins, entity textures, GUI elements, and every vanilla resource available to edit." Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="24,0">
                        <Button Content="Refresh" DockPanel.Dock="Right" Click="Refresh_Click"/>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Height="32" VerticalContentAlignment="Center" Background="{StaticResource SurfaceRaised}" Foreground="{StaticResource PrimaryText}" BorderBrush="{StaticResource BorderBrush}" Padding="10" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TextureCount" Text="0 textures" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                    <Grid Grid.Row="2" Margin="24,0,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Categories" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListBox x:Name="CategoryList" SelectionChanged="CategoryList_SelectionChanged" Background="Transparent" BorderThickness="0"/>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="TextureGrid"/>
                            </ScrollViewer>
                            <Border x:Name="EmptyState" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="30" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="No textures found" FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Refresh to load the vanilla resource catalog." Foreground="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid x:Name="HomeView" Visibility="Collapsed">
                    <StackPanel Margin="28">
                        <TextBlock Text="Bald Launcher" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Native Windows launcher" Foreground="{StaticResource SecondaryText}" Margin="0,8,0,24"/>
                        <Button Content="Browse resource packs" Width="180" HorizontalAlignment="Left" Click="Browse_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SurfaceRaised}">
            <TextBlock x:Name="StatusText" Text="Ready" Margin="14,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" FontSize="11"/>
        </Border>
    </Grid>
</Window>
