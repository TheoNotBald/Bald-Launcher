<Application x:Class="BaldLauncher.Native.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BaldLauncher.Native"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="SurfaceBackground" Color="#111111"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#161616"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#252525"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#858585"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#7EF15E"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Application.Resources>
</Application>
