{
  "name": "bald-launcher",
  "version": "0.1.10",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build:minecraft-mod": "minecraft-mod\\gradlew.bat --no-daemon -p minecraft-mod build",
    "dist": "npm run build:minecraft-mod && electron-builder --win",
    "dist:dir": "npm run build:minecraft-mod && electron-builder --win --dir",
    "dist:publish": "npm run build:minecraft-mod && electron-builder --win --publish always",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.17.0",
    "codemirror": "^5.65.20",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "node-pty": "^1.1.0",
    "pidusage": "^4.0.1",
    "skinview3d": "^3.4.2",
    "three": "^0.156.1"
  },
  "description": "A third-party Minecraft launcher for profiles, content, and self-hosted servers.",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
